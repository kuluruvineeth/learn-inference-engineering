      "customData": {
        "section": "4-causal",
        "anchor": [
          1500,
          4450,
          "lt"
        ]
      },
      "text": "row: a token's query\ncolumn: a key it may look at\ndashed: the future, masked out",
      "originalText": "row: a token's query\ncolumn: a key it may look at\ndashed: the future, masked out",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b2y"
    },
    {
      "id": "4-causal-247",
