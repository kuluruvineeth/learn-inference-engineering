      "customData": {
        "section": "1-request",
        "anchor": [
          0,
          1290,
          "lt"
        ]
      },
      "text": "Every turn of a coding agent sends the whole conversation: the system message with the repo and three tools,\nthen the user's line. The chat template and tokenizer turn it into 870 ids, and the model reads all of them\nbefore it can write one word. Each later turn resends everything: 972, 1,020, 1,089, then 1,132 tokens.",
      "originalText": "Every turn of a coding agent sends the whole conversation: the system message with the repo and three tools,\nthen the user's line. The chat template and tokenizer turn it into 870 ids, and the model reads all of them\nbefore it can write one word. Each later turn resends everything: 972, 1,020, 1,089, then 1,132 tokens.",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ar"
    },
