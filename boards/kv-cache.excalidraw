    },
    {
      "id": "8-cost-1999",
      "type": "text",
      "x": 1640,
      "y": 10784.5,
      "width": 574.08,
      "height": 90,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
