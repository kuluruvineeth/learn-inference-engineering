      "customData": {
        "section": "8-cost",
        "anchor": [
          1640,
          10674.5,
          "lt"
        ]
      },
      "text": "one production engine defaults to 16;\none whose code runs V4.1-Flash uses 128",
      "originalText": "one production engine defaults to 16;\none whose code runs V4.1-Flash uses 128",
      "fontSize": 24,
      "fontFamily": 5,
