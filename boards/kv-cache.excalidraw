      "customData": {
        "section": "6-attention",
        "anchor": [
          0,
          7947,
          "lt"
        ]
      },
      "text": "Prefill packs the five prompts into one flat forward of 5,083 tokens, each prompt attending with its own queries over\nits own keys. In decode, turn 3's 70 entries gather 1,120 rows in logical order, and the mask stops at position 1104,\nso the 15 rows turn 4 left behind in block 250 count for nothing.",
      "originalText": "Prefill packs the five prompts into one flat forward of 5,083 tokens, each prompt attending with its own queries over\nits own keys. In decode, turn 3's 70 entries gather 1,120 rows in logical order, and the mask stops at position 1104,\nso the 15 rows turn 4 left behind in block 250 count for nothing.",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bSS"
