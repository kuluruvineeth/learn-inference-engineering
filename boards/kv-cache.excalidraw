      "locked": false,
      "customData": {
        "section": "2-bytes",
        "anchor": [
          0,
          2760.5,
          "lt"
        ]
      },
      "text": "Sharing 2 KV heads among 14 query heads already cuts Qwen's cache sevenfold. DeepSeek-V3 goes further and keeps\none 576-number latent per layer in place of per-head K and V, 71.1 times less.",
      "originalText": "Sharing 2 KV heads among 14 query heads already cuts Qwen's cache sevenfold. DeepSeek-V3 goes further and keeps\none 576-number latent per layer in place of per-head K and V, 71.1 times less.",
