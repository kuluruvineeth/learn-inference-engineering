        "anchor": [
          1640,
          10534.5,
          "lt"
        ]
      },
      "text": "ours: 16 tokens a block, 7.6 tokens\n(182.4 KiB) wasted per sequence,\n72 table entries",
      "originalText": "ours: 16 tokens a block, 7.6 tokens\n(182.4 KiB) wasted per sequence,\n72 table entries",
      "fontSize": 30,
      "fontFamily": 5,
