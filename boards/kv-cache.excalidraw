      "customData": {
        "section": "1-reserve",
        "anchor": [
          0,
          1210,
          "lt"
        ]
      },
      "text": "The cache from the first request sets aside len(prompt) + max_tokens slots before the first token: 870 + 4,096\nfor turn 0, whose prompt and reply come to 893 tokens. A server batches to be fast (64 requests in one decode\nstep made 625 tokens/s, one request alone 19), and every request in flight holds its whole reservation throughout.",
      "originalText": "The cache from the first request sets aside len(prompt) + max_tokens slots before the first token: 870 + 4,096\nfor turn 0, whose prompt and reply come to 893 tokens. A server batches to be fast (64 requests in one decode\nstep made 625 tokens/s, one request alone 19), and every request in flight holds its whole reservation throughout.",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aX"
    },
