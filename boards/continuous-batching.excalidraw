      "customData": {
        "section": "1-turns",
        "anchor": [
          2284,
          862,
          "lt"
        ]
      },
      "text": "the longest reply\nagainst the shortest",
      "originalText": "the longest reply\nagainst the shortest",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
