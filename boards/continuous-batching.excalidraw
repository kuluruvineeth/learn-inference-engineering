    },
    {
      "id": "1-turns-170",
      "type": "text",
      "x": 0,
      "y": 1010,
      "width": 1201.2,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2529505268,
      "version": 2,
      "versionNonce": 2127356945,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794883837770,
      "link": null,
      "locked": false,
      "customData": {
        "section": "1-turns",
        "anchor": [
          0,
          1010,
          "lt"
        ]
      },
      "text": "the server holds 10 requests, these 5 turns twice, and runs at most 4 at once",
      "originalText": "the server holds 10 requests, these 5 turns twice, and runs at most 4 at once",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1k"
    },
    {
      "id": "1-turns-171",
      "type": "text",
      "x": 0,
      "y": 1060,
      "width": 1060.8,
      "height": 60,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3153284511,
      "version": 2,
      "versionNonce": 1274012031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794883837770,
      "link": null,
      "locked": false,
      "customData": {
        "section": "1-turns",
        "anchor": [
          0,
          1060,
          "lt"
        ]
      },
      "text": "the paged pool from the last topic has room for all of them: 600 blocks of 16 tokens.\nall ten are queued at the start here; real traffic arrives over time",
      "originalText": "the paged pool from the last topic has room for all of them: 600 blocks of 16 tokens.\nall ten are queued at the start here; real traffic arrives over time",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1l"
    },
    {
      "id": "1-turns-172",
      "type": "text",
      "x": 0,
      "y": 1170,
      "width": 1653.6000000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2318960504,
      "version": 2,
      "versionNonce": 345520625,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794883837770,
      "link": null,
      "locked": false,
      "customData": {
        "section": "1-turns",
        "anchor": [
          0,
          1170,
          "lt"
        ]
      },
      "text": "Prompts run 870 to 1,132 tokens and cost one pass each when the budget allows; replies cost one pass per\ntoken and run from 16 to 48. With 600 blocks, memory isn't the limit here. What decides the speed is which\ntokens of which requests go into each forward pass.",
      "originalText": "Prompts run 870 to 1,132 tokens and cost one pass each when the budget allows; replies cost one pass per\ntoken and run from 16 to 48. With 600 blocks, memory isn't the limit here. What decides the speed is which\ntokens of which requests go into each forward pass.",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1m"
    },
    {
