          12923.6,
          "lt"
        ]
      },
      "text": "  launch + max(wait, schedule + update) = 219.7 ms per step vs 219.9 measured at depth 0 (0.1% less)",
      "originalText": "  launch + max(wait, schedule + update) = 219.7 ms per step vs 219.9 measured at depth 0 (0.1% less)",
