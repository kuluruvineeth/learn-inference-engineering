      "customData": {
        "section": "9-in-flight",
        "anchor": [
          1380,
          12303.1,
          "lt"
        ]
      },
      "text": "what this Mac can't show",
      "originalText": "what this Mac can't show",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
