      "boundElements": [],
      "updated": 1794883837770,
      "link": null,
      "locked": false,
      "customData": {
        "section": "4-code",
        "anchor": [
          0,
          5498.7,
          "lt"
        ]
      },
      "text": "A fresh budget starts each step. Running requests go first, decodes ahead of half-done prompts, and each takes\nthe smaller of its work and what is left. Waiting requests then come in, in order, while slots, budget and\nblocks allow. Static batching needs one extra condition and nothing else.",
      "originalText": "A fresh budget starts each step. Running requests go first, decodes ahead of half-done prompts, and each takes\nthe smaller of its work and what is left. Waiting requests then come in, in order, while slots, budget and\nblocks allow. Static batching needs one extra condition and nothing else.",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6N"
    },
