    {
      "id": "4-code-457",
      "type": "text",
      "x": 0,
      "y": 5498.7,
      "width": 1716,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
