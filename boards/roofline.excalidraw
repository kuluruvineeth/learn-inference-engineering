      "isDeleted": false,
      "boundElements": [],
      "updated": 1794883832144,
      "link": null,
      "locked": false,
      "customData": {
        "section": "8-production",
        "anchor": [
          1550.8,
          10974,
          "lt"
        ]
      },
      "text": "a CUDA graph replays a whole recorded step with no per-op launches,\nbut only for the shapes it was recorded with",
      "originalText": "a CUDA graph replays a whole recorded step with no per-op launches,\nbut only for the shapes it was recorded with",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7P"
    },
    {
      "id": "8-production-522",
      "type": "text",
      "x": 1550.8,
      "y": 11074,
      "width": 608.4,
      "height": 75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2311127084,
      "version": 2,
      "versionNonce": 85047899,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794883832144,
      "link": null,
      "locked": false,
      "customData": {
        "section": "8-production",
        "anchor": [
          1550.8,
          11074,
          "lt"
        ]
      },
      "text": "the same idea as our whole-buffer mask:\nfixed shapes, paid for with padding",
      "originalText": "the same idea as our whole-buffer mask:\nfixed shapes, paid for with padding",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7Q"
    },
    {
      "id": "8-production-523",
      "type": "text",
      "x": 1550.8,
      "y": 11184,
      "width": 748.8000000000001,
      "height": 30,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1430119088,
      "version": 2,
      "versionNonce": 1505881301,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794883832144,
      "link": null,
      "locked": false,
      "customData": {
        "section": "8-production",
        "anchor": [
          1550.8,
          11184,
          "lt"
        ]
      },
      "text": "the M1 has no CUDA graphs; we can only show the fixed shapes",
      "originalText": "the M1 has no CUDA graphs; we can only show the fixed shapes",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7R"
    },
    {
      "id": "8-production-524",
      "type": "text",
      "x": 0,
      "y": 11294,
      "width": 1622.4,
      "height": 75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 4133792338,
      "version": 2,
      "versionNonce": 222279419,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794883832144,
      "link": null,
      "locked": false,
      "customData": {
        "section": "8-production",
        "anchor": [
          0,
          11294,
          "lt"
        ]
      },
      "text": "Replaying a recorded graph removes the per-op launches, but a graph fits only the shapes it was recorded\nwith. So the engine keeps eleven of them and rounds each step up: 13 tokens run in the graph for 16.",
      "originalText": "Replaying a recorded graph removes the per-op launches, but a graph fits only the shapes it was recorded\nwith. So the engine keeps eleven of them and rounds each step up: 13 tokens run in the graph for 16.",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7S"
    },
