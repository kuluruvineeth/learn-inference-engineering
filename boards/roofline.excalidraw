      "locked": false,
      "customData": {
        "section": "4-batching",
        "anchor": [
          0,
          5735,
          "lt"
        ]
      },
      "text": "Bytes stay flat as B grows while FLOPs grow with it: about B ÷ 2 FLOP per byte in float32, so 64 rows pass\nthe ridge. The rows can be one prompt or one new token from each of B requests, which is why servers batch\ndecode.",
      "originalText": "Bytes stay flat as B grows while FLOPs grow with it: about B ÷ 2 FLOP per byte in float32, so 64 rows pass\nthe ridge. The rows can be one prompt or one new token from each of B requests, which is why servers batch\ndecode.",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b2u"
    },
