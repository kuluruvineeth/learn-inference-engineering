      "customData": {
        "section": "4-engine",
        "anchor": [
          0,
          4555,
          "lt"
        ]
      },
      "text": "rows 1 and 2: one 870-token turn, the same 8 tokens from both (\"same tokens: True\"); load 14.6\nrow 3: ten turns from two agents, the median of the replies' mean gaps, over 3 runs; each reply matches its reference, 30 of 30; load 32.6\nrow 4: one agent's five turns, one request at a time; its replies match ours, 15 of 15; load 27.0",
      "originalText": "rows 1 and 2: one 870-token turn, the same 8 tokens from both (\"same tokens: True\"); load 14.6\nrow 3: ten turns from two agents, the median of the replies' mean gaps, over 3 runs; each reply matches its reference, 30 of 30; load 32.6\nrow 4: one agent's five turns, one request at a time; its replies match ours, 15 of 15; load 27.0",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
